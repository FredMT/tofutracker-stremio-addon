# Copy to ~/secrets/stremio-addon.env on the server (chmod 600). Never commit the real file.

# Required. 32 random bytes as hex (64 chars) or base64. Encrypts the stored Stremio
# sign-ins and TofuTracker tokens (AES-256-GCM) and signs the personal addon links.
# Generate it on the server and do not print it:   openssl rand -hex 32
# Changing it later makes every stored sign-in unreadable: users must set the addon up again.
STREMIO_CREDS_KEY=

# Where users reach this service. The path is the prefix it is served under.
# PUBLIC_URL=https://scrobble.tofutracker.com/stremio

# The scrobbler's private address (pairing and events).
# SCROBBLER_URL=http://scrobbler:8080

# Container paths and port. Rarely worth changing.
# DATA_DIR=/data
# PORT=7000

# Stremio endpoints. Only change these to point tests at a fake server.
# STREMIO_API_URL=https://api.strem.io
# STREMIO_LINK_URL=https://link.stremio.com
